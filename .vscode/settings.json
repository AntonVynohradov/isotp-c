{
  "// Auto Snippet Configuration": "Automatically insert file headers and templates using Gruntfuggly",
  "// Note": "Pattern matching configuration - snippet names must match exactly in snippet files",
  "autoSnippet.snippets": [
    {
      "pattern": "**/*.h",
      "snippet": "isotp_header"
    },
    {
      "pattern": "**/*.c",
      "snippet": "isotp_source"
    },
    {
      "pattern": "**/gtest_*.cpp",
      "snippet": "isotp_gtest"
    },
    {
      "pattern": "**/*.cmake",
      "snippet": "isotp_cmake"
    }
  ],
  "// C/C++ Intellisense": "Configure C code analysis",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}",
    "${workspaceFolder}/inc"
  ],
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "editor.formatOnSave": true,
  "editor.trimWhitespaceOnDelete": true,
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "*.cmake": "cmake"
  }
}
