      <memberdef kind="function" id="group__isotp__protocol_1gad1a866dca4cfd61976f9066ac315707a" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>uint8_t</type>
        <definition>uint8_t isotp_st_min_encode</definition>
        <argsstring>(uint32_t us)</argsstring>
        <name>isotp_st_min_encode</name>
        <param>
          <type>uint32_t</type>
          <declname>us</declname>
        </param>
        <briefdescription>
<para>Encode a separation time for a Flow Control frame. </para>
        </briefdescription>
        <detaileddescription>
<para>Rounds up, so the sender never sends faster than requested: 0 us gives 0x00, 1..900 us give 0xF1..0xF9 (100 us steps), 901..127000 us give 0x01..0x7F (1 ms steps), larger values 0x7F. <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>us</parametername>
</parameternamelist>
<parameterdescription>
<para>Separation time in microseconds. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Raw STmin byte. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
