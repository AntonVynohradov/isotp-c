</parameternamelist>
<parameterdescription>
<para>Raw STmin byte. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Separation time in microseconds. </para>
</simplesect>
</para>
        </detaileddescription>
