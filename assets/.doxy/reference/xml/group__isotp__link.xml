      <memberdef kind="function" id="group__isotp__link_1ga2883f7405a37500b850b7d45b0367d51" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int isotp_link_send</definition>
        <argsstring>(struct isotp_link *link, const uint8_t *payload, uint32_t length, uint32_t now_us)</argsstring>
        <name>isotp_link_send</name>
        <param>
          <type>struct <ref refid="structisotp__link" kindref="compound">isotp_link</ref> *</type>
          <declname>link</declname>
        </param>
        <param>
          <type>const uint8_t *</type>
          <declname>payload</declname>
        </param>
        <param>
          <type>uint32_t</type>
          <declname>length</declname>
        </param>
        <param>
          <type>uint32_t</type>
          <declname>now_us</declname>
        </param>
        <briefdescription>
<para>Start sending one message to the peer. </para>
        </briefdescription>
        <detaileddescription>
<para>A message of up to 7 bytes is sent at once as a Single Frame and reported to on_tx_done before the call returns. A longer message is copied into the link, its First Frame is sent, and the rest follows from <ref refid="group__isotp__link_1ga9dcb3f75843c4f1c43b16bfca38a0814" kindref="member">isotp_link_poll</ref> as the receiver&apos;s flow control allows. <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>link</parametername>
</parameternamelist>
<parameterdescription>
<para>Link state. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>payload</parametername>
</parameternamelist>
<parameterdescription>
<para>Message bytes. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>length</parametername>
</parameternamelist>
<parameterdescription>
<para>Message length, 1..ISOTP_TX_BUFFER_SIZE. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>now_us</parametername>
</parameternamelist>
<parameterdescription>
<para>Current time in microseconds. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="retval"><parameteritem>
<parameternamelist>
<parametername>ISOTP_OK</parametername>
</parameternamelist>
<parameterdescription>
<para>Message accepted. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>ISOTP_BUSY</parametername>
</parameternamelist>
<parameterdescription>
<para>A segmented transmission is in progress, or the writer is busy. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>ISOTP_ERROR</parametername>
</parameternamelist>
<parameterdescription>
<para>Invalid argument or message too long. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>Other</parametername>
</parameternamelist>
<parameterdescription>
<para>Error returned by the writer. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
